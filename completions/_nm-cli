_nm_wifi() {
    local line state
    local -a curr_cmd_options=(
        --version'[display version and exit]'
        --help'[display usage information and exit]'
        {-i,--ifname}'[Wi-Fi interface to use (default: first found)]':VALUE
    )

    _arguments -C -S -s \
               $curr_cmd_options \
               "1: :->cmds" \
               "*::arg:->args"

    case "$state" in
        cmds)
            _values \
                "nm wifi command" \
                "connect[connect to a Wi-Fi network (personal or enterprise)]" \
                "rescan[request a Wi-Fi scan (results appear in 'wifi' shortly after)]"
            ;;
        args)
            case $line[1] in
                connect)
                    _nm_wifi_connect
                    ;;
                rescan)
                    _nm_wifi_rescan
                    ;;
            esac
            ;;
    esac
}

