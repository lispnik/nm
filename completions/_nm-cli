_nm() {
    local line state
    local -a curr_cmd_options=(
        --version'[display version and exit]'
        --help'[display usage information and exit]'
    )

    _arguments -C -S -s \
               $curr_cmd_options \
               "1: :->cmds" \
               "*::arg:->args"

    case "$state" in
        cmds)
            _values \
                "nm command" \
                "general[show overall NetworkManager status (subcommand: permissions)]" \
                "g[alias for 'general']" \
                "status[alias for 'general']" \
                "device[list devices / show one (subcommands: connect, disconnect)]" \
                "dev[alias for 'device']" \
                "d[alias for 'device']" \
                "wifi[list visible Wi-Fi access points (subcommands: connect, rescan)]" \
                "w[alias for 'wifi']" \
                "connection[list active connections (subcommands: profiles, show, add, modify, up, down, delete)]" \
                "con[alias for 'connection']" \
                "c[alias for 'connection']" \
                "networking[show or set global networking: networking [on|off]]" \
                "radio[show or set radios: radio [wifi|wwan] [on|off]]" \
                "monitor[watch NetworkManager events until interrupted]" \
                "mon[alias for 'monitor']"
            ;;
        args)
            case $line[1] in
                general)
                    _nm_general
                    ;;
                g)
                    _nm_general
                    ;;
                status)
                    _nm_general
                    ;;
                device)
                    _nm_device
                    ;;
                dev)
                    _nm_device
                    ;;
                d)
                    _nm_device
                    ;;
                wifi)
                    _nm_wifi
                    ;;
                w)
                    _nm_wifi
                    ;;
                connection)
                    _nm_connection
                    ;;
                con)
                    _nm_connection
                    ;;
                c)
                    _nm_connection
                    ;;
                networking)
                    _nm_networking
                    ;;
                radio)
                    _nm_radio
                    ;;
                monitor)
                    _nm_monitor
                    ;;
                mon)
                    _nm_monitor
                    ;;
            esac
            ;;
    esac
}

# When autoloaded as the `_nm-cli` completion function, run the top-level
# dispatcher defined above.
_nm "$@"

