_nm_connection_add() {
    local -a curr_cmd_options=(
        --version'[display version and exit]'
        --help'[display usage information and exit]'
        --type'[connection type (required)]':VALUE
        --con-name'[profile name]':VALUE
        --ifname'[bound interface name]':VALUE
        --autoconnect'[yes/no]':VALUE
        --ssid'[Wi-Fi SSID]':VALUE
        --password'[Wi-Fi WPA-PSK passphrase]':VALUE
        --eap'[enterprise EAP method]':VALUE
        --identity'[enterprise identity]':VALUE
        --eap-password'[enterprise password]':VALUE
        --parent'[VLAN parent interface]':VALUE
        --vlan-id'[VLAN id]':VALUE
        --mode'[bond mode]':VALUE
        --method'[ipv4 method (auto/manual/disabled)]':VALUE
        --address'[static IPv4 ADDR/PREFIX]':VALUE
        --gateway'[IPv4 gateway]':VALUE
        --dns'[IPv4 DNS server]':VALUE
    )

    _arguments -C -S -s \
