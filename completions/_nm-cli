#compdef nm-cli
#
# zsh completion for nm-cli (generated by `clingon:print-documentation
# :zsh-completions`, then retargeted from the `nm` command name to the
# installed `nm-cli` binary).
#
# Install: place this file as `_nm-cli` in a directory on your $fpath, e.g.
#
#   mkdir -p ~/.zsh-completions
#   cp completions/_nm-cli ~/.zsh-completions/_nm-cli
#
# and ensure your ~/.zshrc loads it before compinit:
#
#   fpath=(~/.zsh-completions $fpath)
#   autoload -U compinit && compinit

_nm_monitor() {
    local -a curr_cmd_options=(
        --version'[display version and exit]'
        --help'[display usage information and exit]'
    )

    _arguments -C -S -s \
               $curr_cmd_options
}

