               $curr_cmd_options
}

_nm_connection() {
    local line state
    local -a curr_cmd_options=(
        --version'[display version and exit]'
        --help'[display usage information and exit]'
        {-t,--terse}'[terse, colon-separated output]'
        {-j,--json}'[JSON output]'
    )

    _arguments -C -S -s \
               $curr_cmd_options \
               "1: :->cmds" \
               "*::arg:->args"

    case "$state" in
        cmds)
            _values \
                "nm connection command" \
                "profiles[list saved connection profiles]" \
                "list[alias for 'profiles']" \
                "show[show a saved connection profile by id or uuid]" \
                "add[add a saved connection profile (--type ethernet|wifi|vlan|bridge|bond|dummy)]" \
                "modify[set a property on a saved profile: modify <id> <setting.prop> <value>]" \
                "up[activate a saved connection profile by id or uuid]" \
                "down[deactivate an active connection by id or uuid]" \
                "delete[delete a saved connection profile by id or uuid]"
            ;;
        args)
            case $line[1] in
                profiles)
                    _nm_connection_profiles
                    ;;
                list)
                    _nm_connection_profiles
                    ;;
                show)
                    _nm_connection_show
                    ;;
                add)
                    _nm_connection_add
                    ;;
                modify)
                    _nm_connection_modify
                    ;;
                up)
                    _nm_connection_up
                    ;;
                down)
                    _nm_connection_down
                    ;;
                delete)
                    _nm_connection_delete
                    ;;
            esac
            ;;
    esac
}

